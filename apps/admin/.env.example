DATABASE_URL=postgresql://postgres.[project-ref]:[password]@[pooler-host]:6543/postgres
PAYLOAD_SECRET=replace-with-a-random-secret

S3_ENDPOINT=https://[project-ref].storage.supabase.co/storage/v1/s3
S3_REGION=your-storage-region
S3_BUCKET=product_images
S3_ACCESS_KEY_ID=your-storage-access-key
S3_SECRET_ACCESS_KEY=your-storage-secret-key

NEXT_PUBLIC_SUPABASE_URL=https://[project-ref].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-key
NEXT_PUBLIC_PAYLOAD_URL=http://localhost:3001
NEXT_PUBLIC_SITE_URL=http://localhost:3000
RESEND_API_KEY=your-resend-api-key
CAMPAIGN_EMAIL_FROM="NUSC Campaign <campaign@your-verified-domain.com>"

# Optional public store catalogue invalidation. Use the store's matching secret.
STORE_CATALOGUE_REVALIDATION_URL=https://your-store-domain/api/catalogue/revalidate
CATALOGUE_REVALIDATION_SECRET=

# Optional server timings for sign-in, authentication, registrations and list reads.
# Logs operation/stage names and durations only. Disabled unless explicitly true.
NUSC_PERFORMANCE_LOGS=false
