{
  "name": "nagaland-united-sports-club",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @nusc/web -- -p 3000",
    "dev:store": "npm run dev -w @nusc/store -- -p 3103",
    "dev:admin": "npm run dev -w admin",
    "build": "npm run build -w @nusc/web && npm run build -w @nusc/store",
    "build:web": "npm run build -w @nusc/web",
    "build:store": "npm run build -w @nusc/store",
    "start:web": "npm run start -w @nusc/web",
    "start:store": "npm run start -w @nusc/store",
    "lint": "eslint \"apps/{web,store}/src/**/*.{ts,tsx}\" \"tests/**/*.{ts,mjs}\" eslint.config.mjs playwright.config.ts",
    "typecheck": "npm run typecheck -w @nusc/web && npm run typecheck -w @nusc/store",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "test:campaign": "node --test tests/campaign*.test.mjs",
    "test:campaign:browser": "playwright test --config playwright.campaign.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1143.0",
    "@supabase/ssr": "^0.12.7",
    "next": "16.4.3",
    "pg": "^8.23.0",
    "razorpay": "^2.9.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.25.12",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "parse5": "8.0.1",
    "prettier": "3.9.6",
    "typescript": "5.9.3"
  }
}
